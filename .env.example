# ==============================================================================
# QuickCommerce Platform - Root Environment Variables Reference
# Configured for Online Neon PostgreSQL & Online Upstash Redis
# ==============================================================================

# Core API & Worker Settings
NODE_ENV=production
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info
CORS_ORIGIN=*

# Online Neon PostgreSQL (Serverless)
DATABASE_URL="postgresql://user:password@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Online Upstash Redis (Serverless / TLS)
REDIS_URL="rediss://default:your-upstash-password@your-endpoint.upstash.io:6379"

# Security & Secrets
JWT_SECRET="quickcommerce-super-secret-jwt-prod-key-32chars!"
OTP_SECRET_SALT="prod-otp-salt-quickcommerce-2026-secure"
OTP_EXPIRY_MINUTES=60
