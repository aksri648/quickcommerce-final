# ==============================================================================
# QuickCommerce Platform - Root Environment Variables Reference
# ==============================================================================

# Core API & Worker Settings (create apps/api/.env from this template)
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickcommerce?schema=public"

# Redis (BullMQ Queues & Safe Distributed Locks)
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="quickcommerce-super-secret-jwt-dev-key-32chars!"
OTP_SECRET_SALT="dev-otp-salt-quickcommerce-2026"
OTP_EXPIRY_MINUTES=60
