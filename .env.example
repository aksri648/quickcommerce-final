# ==============================================================================
# QuickCommerce Platform - Root Environment Variables Reference
# Configured for Online Neon PostgreSQL (with Neon Managed Auth) & Upstash Redis
# ==============================================================================

# Core API & Worker Settings
NODE_ENV=production
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info
CORS_ORIGIN=*

# Online Neon PostgreSQL (Serverless)
DATABASE_URL="postgresql://user:password@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Online Upstash Redis (Serverless / TLS)
REDIS_URL="rediss://default:your-upstash-password@your-endpoint.upstash.io:6379"

# Security & Secrets (JWT_SECRET must be at least 32 characters long)
JWT_SECRET="quickcommerce-super-secret-jwt-prod-key-32chars!"
OTP_SECRET_SALT="prod-otp-salt-quickcommerce-2026-secure"
OTP_EXPIRY_MINUTES=60

# Neon Managed Auth (Powered by Better Auth)
# NEON_AUTH_BASE_URL="https://auth.neon.tech/..."

# Optional Backblaze B2 Object Storage (Invoice PDFs & Images)
# B2_APPLICATION_KEY_ID="your-key-id"
# B2_APPLICATION_KEY="your-app-key"
# B2_BUCKET_NAME="quickcommerce-assets"

# Frontend PWA Configuration (Vite)
VITE_API_URL="http://localhost:4000/api"
VITE_NEON_AUTH_URL="http://localhost:4000/api/auth"
