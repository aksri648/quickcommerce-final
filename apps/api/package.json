{
  "name": "@quickcommerce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "worker": "bun --watch src/worker.ts",
    "build": "bun build src/server.ts --outdir ./dist --target node && bun build src/worker.ts --outdir ./dist --target node",
    "start": "bun dist/server.js",
    "start:worker": "bun dist/worker.js",
    "db:generate": "bun prisma generate",
    "db:migrate": "bun prisma migrate dev",
    "db:push": "bun prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@orama/orama": "^3.1.18",
    "@prisma/client": "^5.19.0",
    "@quickcommerce/shared": "workspace:*",
    "better-auth": "^1.7.2",
    "bullmq": "^5.12.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.19.0",
    "typescript": "^5.5.4"
  }
}
