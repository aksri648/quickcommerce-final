# ==============================================================================
# QuickCommerce Platform - Backend API Environment Variables
# Configured for Online Neon PostgreSQL & Online Upstash Redis
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Timezone
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Paste your Neon Connection String below (must include ?sslmode=require)
# Example: postgresql://neondb_owner:npg_xyz@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Cache & Background Queues (Upstash Cloud / Serverless Redis)
# ------------------------------------------------------------------------------
# Paste your Upstash Redis Connection String below (starts with rediss:// for TLS)
# Example: rediss://default:Axxxxxxx@global-xyz-123.upstash.io:6379
REDIS_URL="rediss://default:your-upstash-password@your-endpoint.upstash.io:6379"

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security (Min 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET="quickcommerce-super-secret-jwt-prod-key-32chars!"

# ------------------------------------------------------------------------------
# 5. Cryptographic Doorstep OTP Security
# ------------------------------------------------------------------------------
OTP_SECRET_SALT="prod-otp-salt-quickcommerce-2026-secure"
OTP_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# 6. Optional Auth0 Integration (Production SSO)
# ------------------------------------------------------------------------------
# AUTH0_DOMAIN="your-tenant.auth0.com"
# AUTH0_AUDIENCE="https://api.quickcommerce.com"

# ------------------------------------------------------------------------------
# 7. Optional Backblaze B2 Object Storage (Invoice PDFs & Images)
# ------------------------------------------------------------------------------
# B2_APPLICATION_KEY_ID="your-key-id"
# B2_APPLICATION_KEY="your-app-key"
# B2_BUCKET_NAME="quickcommerce-assets"
