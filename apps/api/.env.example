# ==============================================================================
# QuickCommerce API - Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=info
CORS_ORIGIN=*

# Online Neon PostgreSQL (Serverless)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickcommerce?sslmode=require"

# Online Upstash Redis (Serverless / TLS)
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="quickcommerce-super-secret-jwt-dev-key-32chars!"
OTP_SECRET_SALT="dev-otp-salt-quickcommerce-2026"
OTP_EXPIRY_MINUTES=60

# Neon Managed Auth
# NEON_AUTH_BASE_URL="https://auth.neon.tech/..."

# Optional Backblaze B2 Object Storage
# B2_APPLICATION_KEY_ID="your-key-id"
# B2_APPLICATION_KEY="your-app-key"
# B2_BUCKET_NAME="quickcommerce-assets"
